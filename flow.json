    {
        "id": "in-forecast-data",
        "type": "mqtt in",
        "z": "tab-flood-system",
        "name": "MQTT: flood/prediction",
        "topic": "flood/prediction",
        "qos": "1",
        "datatype": "json",
        "broker": "broker-hivemq-cloud",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 140,
        "y": 320,
        "wires": [
            [
                "fn-parse-forecast"
            ]
        ]
    },
    {
        "id": "fn-parse-forecast",
        "type": "function",
        "z": "tab-flood-system",
        "name": "Parse LSTM Predictions",
        "func": "const p = msg.payload;\nif (!p) return null;\n\nconst forecast = Number(p.predicted_water_level) || 0;\nconst risk = p.risk_level || 'SAFE';\nconst action = p.recommended_action || 'Monitoring';\nconst warning = p.warning_message || '';\nconst rise = p.rate_of_rise !== undefined ? (p.rate_of_rise >= 0 ? '+' : '') + Number(p.rate_of_rise).toFixed(2) + ' m' : '';\n\n// Output 1: Forecast Gauge\nconst m1 = { payload: forecast, topic: 'Forecast (m)' };\n// Output 2: Risk Banner\nlet color = '#27ae60';\nif (risk === 'WATCH') color = '#f39c12';\nelse if (risk === 'WARNING') color = '#e67e22';\nelse if (risk === 'CRITICAL') color = '#c0392b';\n\nconst m2 = {\n    payload: `<div style=\"background-color:${color}; color:white; padding:12px; border-radius:8px; text-align:center;\">\n        <h2 style=\"margin:0; font-size:20px;\">STATUS: ${risk}</h2>\n        <p style=\"margin:4px 0 0 0; font-size:13px;\">${warning}</p>\n        <p style=\"margin:2px 0 0 0; font-size:12px; opacity:0.9;\">Rate of Rise: ${rise}</p>\n    </div>`\n};\n\n// Output 3: Recommended Action text\nconst m3 = { payload: action };\n\n// Output 4: Forecast chart line\nconst m4 = { payload: forecast, topic: 'LSTM Predicted Level (m)' };\n\n// Output 5: Alert toast (if warning or critical)\nconst m5 = (risk === 'WARNING' || risk === 'CRITICAL') ? { payload: warning, topic: 'FLOOD ALERT: ' + risk } : null;\n\nreturn [m1, m2, m3, m4, m5];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 320,
        "wires": [
            [
                "ui-gauge-forecast"
            ],
            [
                "ui-html-risk-card"
            ],
            [
                "ui-text-action"
            ],
            [
                "ui-chart-trends"
            ],
            [
                "ui-toast-alert"
            ]
        ]
    },
