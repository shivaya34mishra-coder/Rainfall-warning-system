    {
        "id": "fn-parse-forecast",
        "type": "function",
        "z": "tab-flood-system",
        "name": "Parse LSTM Predictions",
        "func": "const p = msg.payload;\nif (!p) return null;\n\nconst forecast = Number(p.predicted_water_level) || 0;\nconst risk = p.risk_level || 'SAFE';\nconst action = p.recommended_action || 'Monitoring';\nconst warning = p.warning_message || '';\nconst rise = p.rate_of_rise !== undefined ? (p.rate_of_rise >= 0 ? '+' : '') + Number(p.rate_of_rise).toFixed(2) + ' m' : '';\n\n// Output 1: Forecast Gauge\nconst m1 = { payload: forecast, topic: 'Forecast (m)' };\n// Output 2: Risk Banner\nlet grad = 'linear-gradient(135deg, rgba(16,185,129,0.3) 0%, rgba(6,78,59,0.7) 100%)';\nlet border = '#10b981';\nlet icon = '🟢';\nif (risk === 'WATCH') {\n    grad = 'linear-gradient(135deg, rgba(245,158,11,0.3) 0%, rgba(120,53,15,0.7) 100%)';\n    border = '#f59e0b';\n    icon = '🟡';\n} else if (risk === 'WARNING') {\n    grad = 'linear-gradient(135deg, rgba(249,115,22,0.35) 0%, rgba(154,52,18,0.7) 100%)';\n    border = '#f97316';\n    icon = '🟠';\n} else if (risk === 'CRITICAL') {\n    grad = 'linear-gradient(135deg, rgba(239,68,68,0.4) 0%, rgba(153,27,27,0.85) 100%)';\n    border = '#ef4444';\n    icon = '🔴';\n}\n\nconst m2 = {\n    payload: `<div style=\"background:${grad}; border:1px solid ${border}; box-shadow:0 0 20px rgba(0,0,0,0.4); color:white; padding:14px; border-radius:12px; text-align:center;\">\n        <h2 style=\"margin:0; font-size:18px; font-weight:800; letter-spacing:0.5px;\">${icon} STATUS: ${risk}</h2>\n        <p style=\"margin:5px 0 0 0; font-size:12px; opacity:0.95;\">${warning}</p>\n        <p style=\"margin:3px 0 0 0; font-size:11px; opacity:0.85; font-family:monospace;\">Rate of Rise: ${rise}</p>\n    </div>`\n};\n\n// Output 3: Recommended Action text\nconst m3 = { payload: action };\n\n// Output 4: Forecast chart line\nconst m4 = { payload: forecast, topic: 'LSTM Predicted Crest (m)' };\n\n// Output 5: Alert toast (if warning or critical)\nconst m5 = (risk === 'WARNING' || risk === 'CRITICAL') ? { payload: warning, topic: '🚨 FLOOD ALERT: ' + risk } : null;\n\nreturn [m1, m2, m3, m4, m5];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 320,
