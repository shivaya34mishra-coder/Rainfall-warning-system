    {
        "id": "in-rainfall-data",
        "type": "mqtt in",
        "z": "tab-flood-system",
        "name": "MQTT: rainfall/data",
        "topic": "rainfall/data",
        "qos": "1",
        "datatype": "json",
        "broker": "broker-hivemq-cloud",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 140,
        "wires": [
            [
                "fn-split-sensor-data"
            ]
        ]
    },
    {
        "id": "fn-split-sensor-data",
        "type": "function",
        "z": "tab-flood-system",
        "name": "Parse Sensor Stream",
        "func": "const p = msg.payload;\nif (!p) return null;\n\nconst rainfall = Number(p.rainfall) || 0;\nconst water_level = Number(p.water_level) || 0;\nconst condition = p.weather_condition || 'Normal';\nconst ts = p.timestamp ? new Date(p.timestamp).toLocaleTimeString() : new Date().toLocaleTimeString();\n\n// Output 1: Rainfall Gauge\nconst m1 = { payload: rainfall, topic: 'Rainfall (mm)' };\n// Output 2: Water Level Gauge\nconst m2 = { payload: water_level, topic: 'Water Level (m)' };\n// Output 3: Status / Phase text\nconst m3 = { payload: condition + ' (' + ts + ')' };\n// Output 4: Chart payload (water level)\nconst m4 = { payload: water_level, topic: 'Current Water Level (m)' };\n\nreturn [m1, m2, m3, m4];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 140,
        "wires": [
            [
                "ui-gauge-rain"
            ],
            [
                "ui-gauge-water"
            ],
            [
                "ui-text-weather"
            ],
            [
                "ui-chart-trends"
            ]
        ]
    },
