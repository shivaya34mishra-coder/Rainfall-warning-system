        "format": "<style>\n  body.nr-dashboard-theme { background: radial-gradient(circle at 10% 20%, #0a0f1d 0%, #050811 90%) !important; color: #f1f5f9 !important; font-family: 'Inter', -apple-system, sans-serif !important; }\n  .nr-dashboard-cardpanel { background: rgba(15, 23, 42, 0.7) !important; backdrop-filter: blur(12px) !important; border-radius: 16px !important; border: 1px solid rgba(255,255,255,0.08) !important; box-shadow: 0 10px 30px rgba(0,0,0,0.5) !important; }\n  .nr-dashboard-cardtitle { color: #38bdf8 !important; font-weight: 700 !important; font-size: 15px !important; text-transform: uppercase !important; letter-spacing: 0.5px !important; }\n  md-toolbar.site-title { background: linear-gradient(90deg, #1e3a8a, #0f172a) !important; box-shadow: 0 4px 20px rgba(0,0,0,0.4) !important; }\n  .nr-dashboard-theme ui-gauge text { fill: #f1f5f9 !important; font-family: 'JetBrains Mono', monospace !important; }\n</style>",
