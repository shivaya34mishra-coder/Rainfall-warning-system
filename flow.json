        "id": "in-forecast-data",
        "type": "mqtt in",
        "z": "tab-flood-system",
        "name": "MQTT: flood/prediction",
        "topic": "flood/prediction",
        "qos": "1",
        "datatype": "json",
        "broker": "broker-hivemq-cloud",
        "nl": false,
        "rap": true,
